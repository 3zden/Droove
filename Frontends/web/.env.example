# Relative paths on purpose: the browser talks to one origin and something in front
# routes to the right service - the Vite dev proxy today (see vite.config.ts), the
# api-gateway later. Nothing here needs a hostname until you deploy.
VITE_USER_API_URL=/api/users
# trips.ts appends "/trips" itself, so this stops one segment short.
VITE_TRIPS_API_URL=/api
VITE_PRICING_API_URL=/api/pricing
VITE_ROUTING_API_URL=/api/routing

# Not proxied yet - these services don't exist.
VITE_PAYMENTS_API_URL=http://localhost:8105
VITE_SCHEDULING_API_URL=http://localhost:8106
VITE_LOCATION_WS_URL=ws://localhost:8201
VITE_NOTIFICATION_WS_URL=ws://localhost:8202
